# =============================================================================
# AfyaSasa — environment template (copy to .env and adjust per environment)
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=afyasasa
POSTGRES_USER=afyasasa
POSTGRES_PASSWORD=change-me-strong-password
# If you change this after first `docker compose up`, the existing Postgres volume keeps the old password.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DEFAULT_TENANT_SCHEMA=demo
DEFAULT_TENANT_CODE=jalaram
# Clinical numbers: JH-2026-00001, JH-OPD-2026-00001, JH-IPD-2026-00001, …
HOSPITAL_NUMBER_PREFIX=JH
TYPEORM_MIGRATIONS_RUN=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (use long random strings in production) ---
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Object storage (MinIO / S3 / R2 / Azure Blob) ---
MINIO_ROOT_USER=afyasasa
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT=http://localhost:9000
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (docker-compose syncs these for the backend)
S3_ACCESS_KEY_ID=afyasasa
S3_SECRET_ACCESS_KEY=change-me-minio-password
S3_BUCKET=afyasasa-clinical-files
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Browser-facing endpoint for presigned URLs — proxied via nginx at /minio/ (same origin as the app)
S3_PUBLIC_ENDPOINT=http://localhost:8080/minio

# --- SMS (Celcom Africa recommended for Kenya) ---
# stub | celcom_africa | africas_talking | twilio
SMS_PROVIDER=celcom_africa
SMS_SENDER_NAME=JALARAM
CELCOM_API_KEY=your-celcom-api-key
CELCOM_PARTNER_ID=your-partner-id
CELCOM_SHORTCODE=JALARAMHNKR
# Optional: npm run test:sms with SMS_TEST_MOBILE=07XXXXXXXX
# SMS_TEST_MOBILE=
# CELCOM_SMS_URL=https://isms.celcomafrica.com/api/services/sendsms/
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (when implemented) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@your-hospital.local
APP_PUBLIC_URL=http://localhost:8080

# --- M-Pesa Daraja (STK push for walk-in lab payments) ---
# Leave unset to simulate STK in development (mock checkout IDs)
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-public-url/api/v1/payments/mpesa/callback

# --- QuickBooks Desktop v14 (Web Connector) ---
# Install QBWC on the finance PC and point it to:
# POST https://your-public-url/api/v1/integrations/quickbooks/webconnector
# QBWC_USER=afyasasa
# QBWC_PASSWORD=change-me-qbwc-password

# --- Frontend build (set in frontend/.env or Docker build args) ---
# VITE_API_BASE_URL=/api/v1
# VITE_SOCKET_URL=
# VITE_DEFAULT_TENANT=jalaram
# HOSPITAL_NUMBER_PREFIX=JH
# VITE_HIDE_TENANT_SELECTOR=true

# =============================================================================
# Production notes
# =============================================================================
# 1. Set NODE_ENV=production
# 2. Use strong secrets for JWT, Postgres, MinIO, and S3 credentials
# 3. Point FRONTEND_ORIGIN to your public URL (e.g. https://emr.hospital.go.ke)
# 4. Behind Nginx/Cloudflare: VITE_API_BASE_URL=/api/v1 (relative path via proxy)
#    Set S3_PUBLIC_ENDPOINT=https://emr.your-hospital.go.ke/minio for browser uploads
# 5. Set SMS_PROVIDER=celcom_africa with CELCOM_API_KEY + CELCOM_PARTNER_ID when ready
# 6. Run: npm run preflight && docker compose up -d --build
# 7. Health: GET /api/v1/health and admin system health endpoint

# --- SHA / HIE (Digital Health Agency) ---
# Official public site: https://sha.go.ke
# Provider portal: https://portal.sha.go.ke
# HIE docs: https://hie-docs.dha.go.ke/docs/claims/process/eligibility/eligibilityCheck
# auto = live when credentials are set, otherwise disconnected (never fake "verified")
# stub = practice responses only (00000000 = not found, 11111111 = ineligible)
SHA_MODE=auto
SHA_HIE_BASE_URL=https://ilm-dev.dha.go.ke/uat-middleware/api/v1
SHA_CLIENT_ID=
SHA_CLIENT_SECRET=
SHA_FACILITY_FR_CODE=
